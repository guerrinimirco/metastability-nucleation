# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/
.venv/

# --- OS ---------------------------------------------------------------------
.DS_Store

# --- Machine-local Claude Code settings --------------------------------------
# .claude/settings.json IS tracked (shared); the .local one is per-machine.
.claude/settings.local.json

# --- Notebooks ---------------------------------------------------------------
# The jupytext .py mirror is the source of truth (reviewable diffs). The .ipynb
# is regenerated by `jupytext --sync` and carries megabytes of cell outputs.
#notebooks/*.ipynb

# --- Generated output --------------------------------------------------------
# Everything under output/ is generated. We commit only the small artefacts a
# reader needs to redraw the paper figures without a multi-hour recompute:
# figures, the CSVs behind them, the sigma_crit .npz grids and the TOV tables.
# The Q* and thermal-nucleation tables are many GB and are regenerated by
# Part II of the notebook.
#
# NOTE: git cannot re-include a file whose PARENT DIRECTORY is excluded, so
# these must be `dir/*` patterns with a negation at every level -- never `dir/`.
output/*
!output/paper/
output/paper/*
!output/paper/figures/
!output/paper/figure_data/
!output/paper/tables/
output/paper/tables/*
!output/paper/tables/hadronic_tov/
!output/paper/tables/quark_tov/
!output/paper/tables/sigma_crit/

# Smoke-test output (REDUCED_GRID=True) is never committed.
output/smoke/

# --- Manuscript --------------------------------------------------------------
# The paper source lives with the paper, not in the code repo.
nucleation_Physical_Review/
*.zip
